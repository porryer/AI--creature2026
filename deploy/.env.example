# staging 环境配置：复制为 deploy/.env 后填写。该文件含密钥，不要提交到仓库。
# 生成 32 字节密钥：openssl rand -hex 32

POSTGRES_PASSWORD=
JWT_SECRET=
PHONE_ENC_KEY=
PHONE_HASH_KEY=
FILE_SIGNING_SECRET=
# 访问 /v1/metrics 的令牌（Prometheus 抓取时放在 Authorization: Bearer 中）
METRICS_TOKEN=

# 管理员手机号（逗号分隔）
ADMIN_PHONES=

# 对外访问地址与端口
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080
COOKIE_SECURE=false

# staging 默认使用 Mock 集成（短信验证码直接返回、模拟支付、Mock 模型），不要对外开放
SMS_MODE=dev
PAYMENTS_MODE=mock
PROVIDER_MODE=mock

# 基础镜像（无法访问 Docker Hub 时换成镜像站，如 mirror.gcr.io/library/node:22-alpine）
# NODE_IMAGE=node:22-alpine
# NGINX_IMAGE=nginx:1.27-alpine
# POSTGRES_IMAGE=postgres:16-alpine
