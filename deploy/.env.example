# staging 环境配置：复制为 deploy/.env 后填写。该文件含密钥，不要提交到仓库。
# 生成 32 字节密钥：openssl rand -hex 32

POSTGRES_PASSWORD=
JWT_SECRET=
PHONE_ENC_KEY=
PHONE_HASH_KEY=
FILE_SIGNING_SECRET=
# 访问 /v1/metrics 的令牌（Prometheus 抓取时放在 Authorization: Bearer 中）
METRICS_TOKEN=

# 管理员手机号（逗号分隔）
ADMIN_PHONES=

# 对外访问地址与端口
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080
COOKIE_SECURE=false

# staging 默认使用 Mock 集成（短信验证码直接返回、模拟支付、Mock 模型），不要对外开放
SMS_MODE=dev
PAYMENTS_MODE=mock
PROVIDER_MODE=mock

# 文件存储：local 为本地卷（单机）；s3 为 S3 兼容对象存储（多台机器部署时必须，生产环境必须）
# 使用编排内的 MinIO：取消下面的注释，填写密钥（至少 8 位），并以 docker compose --profile s3 up -d 启动
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://minio:9000
# 浏览器访问存储的地址（上传与读取文件都直接访问存储，预签名地址按此生成）
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=creature
# S3_ACCESS_KEY_ID=creature
# S3_SECRET_ACCESS_KEY=
# MinIO 需要路径风格；阿里云 OSS / 腾讯云 COS 使用虚拟主机风格（false），并在控制台为存储桶配置允许本站来源 PUT / GET 的跨域规则
# S3_FORCE_PATH_STYLE=true
# MINIO_PORT=9000

# 基础镜像（无法访问 Docker Hub 时换成镜像站，如 mirror.gcr.io/library/node:22-alpine）
# NODE_IMAGE=node:22-alpine
# NGINX_IMAGE=nginx:1.27-alpine
# POSTGRES_IMAGE=postgres:16-alpine
# MINIO_IMAGE=minio/minio:latest
