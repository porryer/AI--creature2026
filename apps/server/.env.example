# 造物 Creature 后端配置示例（复制为 .env 或在部署平台设置环境变量）
# 开发环境全部可留空：使用内嵌 PGlite、Mock 模型供应商、开发模式短信与模拟支付

NODE_ENV=development
# APP_ENV=staging：密钥与数据库按生产要求校验，但允许 Mock 的短信 / 支付 / 模型（见 deploy/）
APP_ENV=
PORT=3000

# 数据库：设置后连接 PostgreSQL；留空使用 PGlite（数据目录 PGLITE_DIR，默认 .data/pglite）
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# 密钥（生产环境必填）。PHONE_* 为 32 字节：64 位十六进制或 base64
JWT_SECRET=
PHONE_ENC_KEY=
PHONE_HASH_KEY=
FILE_SIGNING_SECRET=

# 文件存储与访问
STORAGE_DIR=.data/files
FILE_URL_TTL_SEC=7200
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:5173

# 外部集成：开发环境为 dev / mock，生产环境必须改为 provider / live 并实现对应适配器
SMS_MODE=dev
PAYMENTS_MODE=mock
PROVIDER_MODE=mock

# Worker（与 API 同进程运行；多实例部署时可只在部分实例开启）
WORKER_ENABLED=true
WORKER_POLL_MS=500
# 每个实例每个模态同时处理的任务数（默认值），可按模态覆盖；停机时等待处理中任务的时长，超时的任务重新排队
WORKER_CONCURRENCY=4
# WORKER_CONCURRENCY_IMAGE=4
# WORKER_CONCURRENCY_VIDEO=2
# WORKER_CONCURRENCY_TEXT=8
# WORKER_CONCURRENCY_AUDIO=4
WORKER_SHUTDOWN_GRACE_MS=8000

# Mock 供应商模拟耗时（毫秒）
MOCK_LATENCY_IMAGE_MS=3000
MOCK_LATENCY_VIDEO_MS=8000
MOCK_LATENCY_TEXT_MS=1500
MOCK_LATENCY_AUDIO_MS=2500

# 隐式标识中的服务提供者编码；额外的审核关键词（逗号分隔）
SERVICE_PROVIDER_CODE=CREATURE-DEV
MODERATION_EXTRA_WORDS=

# 登录时授予管理后台权限的手机号（逗号分隔）
ADMIN_PHONES=

# 运维：/v1/metrics 令牌（staging / 生产未设置时该接口不开放）、访问日志、Cookie 仅 HTTPS（生产默认开启）
METRICS_TOKEN=
ACCESS_LOG=true
# COOKIE_SECURE=true

# 防刷：每个用户每分钟最多提交的生成任务数、同时进行中的任务上限
GENERATION_RATE_PER_MIN=30
MAX_INFLIGHT_TASKS=20

# 定时全量对账间隔（小时）
RECONCILE_INTERVAL_HOURS=24

# 多实例之间广播推送事件的 PostgreSQL 通知频道；多个环境共用一个数据库时各用不同的频道
EVENTS_CHANNEL=creature_events

# 文件存储：local（STORAGE_DIR 本地目录）或 s3（S3 兼容对象存储：阿里云 OSS、腾讯云 COS、火山引擎 TOS、MinIO、AWS S3）
STORAGE_DRIVER=local
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# S3_PUBLIC_ENDPOINT=                  # 浏览器访问的地址（如 CDN 域名），默认同 S3_ENDPOINT
# S3_REGION=oss-cn-hangzhou             # 地址与区域按服务商的 S3 兼容文档填写
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false            # MinIO 设为 true
