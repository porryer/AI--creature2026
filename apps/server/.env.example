# 造物 Creature 后端配置示例（复制为 .env 或在部署平台设置环境变量）
# 开发环境全部可留空：使用内嵌 PGlite、Mock 模型供应商、开发模式短信与模拟支付

NODE_ENV=development
PORT=3000

# 数据库：设置后连接 PostgreSQL；留空使用 PGlite（数据目录 PGLITE_DIR，默认 .data/pglite）
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# 密钥（生产环境必填）。PHONE_* 为 32 字节：64 位十六进制或 base64
JWT_SECRET=
PHONE_ENC_KEY=
PHONE_HASH_KEY=
FILE_SIGNING_SECRET=

# 文件存储与访问
STORAGE_DIR=.data/files
FILE_URL_TTL_SEC=7200
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:5173

# 外部集成：开发环境为 dev / mock，生产环境必须改为 provider / live 并实现对应适配器
SMS_MODE=dev
PAYMENTS_MODE=mock
PROVIDER_MODE=mock

# Worker（与 API 同进程运行；多实例部署时可只在部分实例开启）
WORKER_ENABLED=true
WORKER_POLL_MS=500
WORKER_CONCURRENCY=4

# Mock 供应商模拟耗时（毫秒）
MOCK_LATENCY_IMAGE_MS=3000
MOCK_LATENCY_VIDEO_MS=8000
MOCK_LATENCY_TEXT_MS=1500
MOCK_LATENCY_AUDIO_MS=2500

# 隐式标识中的服务提供者编码；额外的审核关键词（逗号分隔）
SERVICE_PROVIDER_CODE=CREATURE-DEV
MODERATION_EXTRA_WORDS=
